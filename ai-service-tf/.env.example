# EfficientNetV2B0 inference service configuration.
# Copy to .env and fill in real values. INTERNAL_API_TOKEN must match the backend's.

# Path to the Keras checkpoint, relative to ai-service-tf/ or absolute.
MODEL_WEIGHTS_PATH=weights/pneumonia_efficientnetv2b0_final.keras

# Shared secret the backend sends as X-Internal-Token. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=

# Grad-CAM roughly doubles request time. Disable for throughput-bound deployments.
ENABLE_GRADCAM=true

# Reject absurdly large uploads before decoding, as a decompression-bomb guard.
MAX_IMAGE_DIMENSION=10000

# Leave empty when only the backend calls this service (the intended topology).
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
