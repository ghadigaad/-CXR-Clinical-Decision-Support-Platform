# ---- Server ----
NODE_ENV=development
PORT=4000
# Origin of the frontend, used for CORS and cookie policy.
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# SQLite for local development. Hosted deploys switch the Prisma provider to
# postgresql at build time (see DEPLOY.md) and use a postgres URL here.
DATABASE_URL="file:./dev.db"
# Direct (non-pooled) Postgres URL. Required on Render/Supabase when using the
# connection pooler. Leave unset for local SQLite.
# DIRECT_URL="postgresql://postgres:...@db.PROJECT.supabase.co:5432/postgres"

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=8h
# Set true when serving over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Supabase Auth (email one-time codes). Copy from Project Settings → API.
# The service_role key is server-only. Never put it in the frontend or commit it.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key

# ---- AI integration ----
# "real" calls the FastAPI inference service. "mock" uses the isolated development
# stub in src/services/providers/mockAiProvider.ts and tags every response as mock.
# There is no automatic fallback from real to mock.
AI_PROVIDER=real
AI_SERVICE_URL=http://localhost:8000
# EfficientNetV2-B0 inference service (TensorFlow), used when the clinician selects that model.
AI_EFFICIENTNET_URL=http://localhost:8001
# Must match INTERNAL_API_TOKEN in ai-service/.env.
INTERNAL_API_TOKEN=change-me-to-a-long-random-string
AI_REQUEST_TIMEOUT_MS=60000
AI_ENABLE_GRADCAM=true

# ---- Uploads ----
MAX_UPLOAD_BYTES=10485760

# ---- Image retention ----
# Persist the full-resolution X-ray. Off by default: images are held in memory only.
STORE_ORIGINAL_IMAGES=false
# Directory used only when STORE_ORIGINAL_IMAGES=true.
IMAGE_STORAGE_DIR=./storage/images
# Persist a downscaled thumbnail and the Grad-CAM overlay so patient history can show
# them. Set false for a no-image-retention deployment.
STORE_THUMBNAILS=true
THUMBNAIL_SIZE=256
# Larger rendition shown in the viewer and report. Still a downscale of the original.
DISPLAY_IMAGE_SIZE=1024

# ---- Logging ----
LOG_LEVEL=info
