# Base path for API requests. Leave empty to use the Vite dev proxy (recommended in
# development) or same-origin routing in production behind a reverse proxy.
#
# There are no secrets here by design: the frontend never holds an API key. All
# privileged calls go through the backend, which owns the AI service token.
VITE_API_BASE_URL=

# Hosted demos must set this so the UI shows "not for clinical use" and forbids PHI.
# Leave unset (or false) for a local development copy.
VITE_DEMO_MODE=false
