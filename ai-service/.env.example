# Path to the trained checkpoint exported from the Colab notebook.
# See EXPORT_WEIGHTS.md. Relative paths resolve against the ai-service/ directory.
MODEL_WEIGHTS_PATH=weights/best_model.pt

# Shared secret the backend must send as the X-Internal-Token header.
# Must match INTERNAL_API_TOKEN in backend/.env. Generate a long random value.
INTERNAL_API_TOKEN=change-me-to-a-long-random-string

# "cuda", "cpu", or "auto" to prefer CUDA when available.
DEVICE=auto

# Set false to skip Grad-CAM entirely (faster, no explainability output).
ENABLE_GRADCAM=true

# Reject decoded images larger than this on either axis (guards against decompression bombs).
MAX_IMAGE_DIMENSION=10000

# Comma-separated origins allowed to call this service directly.
# Normally empty: only the backend should talk to the AI service.
ALLOWED_ORIGINS=

LOG_LEVEL=INFO
